# Homelab – segmentovaná síť
# FreeRADIUS authorize - MAB – VZOR (ukázka struktury; skutečný soubor je generovaný a obsahuje více záznamů)
# Klíč: MAC adresa malými písmeny bez oddělovačů (viz policy.d/mab), hodnoty určují VLAN.

# === VLAN42 (trusted) ===

00005e005301    Auth-Type := Accept
                Tunnel-Type = VLAN,
                Tunnel-Medium-Type = IEEE-802,
                Tunnel-Private-Group-ID = "42",
                Mikrotik-Wireless-VLANID = 42

